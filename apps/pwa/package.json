    "@googlemaps/js-api-loader": "^2.0.2",
    "@graphql-codegen/cli": "^6.3.1",
    "@joy-one/apis": "workspace:*",
    "@joy-one/config": "workspace:*",
    "@joy-one/utils": "workspace:*",
    "@lingui/core": "^5.9.5",
    "@lingui/macro": "^5.9.5",
